# OPENROUTER_API_KEY: Required for AI recipe calls (free models available).
# Create a free key at https://openrouter.ai/keys — no card needed for free models.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: free vision model used by default.
# Verified free + vision + JSON mode: nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
