# OPENROUTER_API_KEY: Required for AI recipe calls (free models available).
# Create a free key at https://openrouter.ai/keys — no card needed for free models.
# Set in Vercel (Production + Preview + Development). Never commit a real key.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: free vision model used by default.
# Verified free + vision + JSON mode: nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated list of extra origins allowed to call
# /api/* from a browser (CORS). Leave empty for same-origin only (the
# default — the app's own frontend calls the API from the same origin).
# Example: ALLOWED_ORIGINS="https://app.example.com"
ALLOWED_ORIGINS=""

# RATE_LIMIT_SCANS_PER_HOUR: max fridge scans per client IP per hour.
# RATE_LIMIT_RECIPES_PER_HOUR: max recipe-generation calls per IP per hour.
# Exceeding a limit returns HTTP 429 with a Retry-After header.
RATE_LIMIT_SCANS_PER_HOUR=10
RATE_LIMIT_RECIPES_PER_HOUR=20

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: Optional but
# recommended. When set (Upstash Redis, free tier), rate limits are
# shared across serverless instances and long AI calls run as async
# jobs (202 + polling via GET /api/jobs/:id) instead of holding a
# synchronous connection open. When unset, the app still works:
# rate limiting falls back to in-memory (best-effort) and AI calls run
# synchronously. Create a free database at https://console.upstash.com
# and paste the REST URL + token into Vercel env vars.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SUPABASE (login + database): the "mise" project, region ap-south-1.
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are public by design
# (the anon key only identifies the project; row-level security
# decides what a user may read/write) — set in Vercel for Production
# + Preview. SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY: it bypasses
# row-level security, so it must never have a VITE_ prefix, never be
# committed, and never be logged. The app works as a guest when these
# are absent — sign-in simply does not appear.
VITE_SUPABASE_URL="https://woczqvbzrxekfckhfyui.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
